{
  "name": "medleyplay-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web client for medleyplay, a music player for the local network.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typescript/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint:js": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"src/**/*.css\" --cache --cache-location .cache/stylelint/",
    "format": "prettier --check . --cache --cache-location .cache/prettier/.prettier-cache",
    "format:write": "prettier --write . --cache --cache-location .cache/prettier/.prettier-cache",
    "check": "npm run typecheck && npm run lint:js && npm run lint:css && npm run format && npm run test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@picocss/pico": "^2.1.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
